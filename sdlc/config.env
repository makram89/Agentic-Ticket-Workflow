# Project config for the sdlc plugin. Sourced by shell scripts: KEY=value, no spaces around '='.
LANGUAGE=en                      # language of generated artifacts (spec, scenarios, reports)
TIER=standard                    # focused | standard | full
ISOLATION=sandbox                # docker | sandbox
IMAGE=sdlc-coder-python          # docker image for the coder (see docker/profiles)
TEST_CMD="pytest -q"             # run from the repo root; must exit non-zero on failure
TEST_PATHS="tests pytest.ini conftest.py .github/workflows/infra.yml infra/.tflint.hcl"   # test surface: tests + anything that changes test behaviour
HOLDOUT_CMD=""                   # optional: command for sdlc/changes/<id>/holdout/ tests the coder never sees
MAX_ITERATIONS=5
