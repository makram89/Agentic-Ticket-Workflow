# Copy to .env (never commit .env). Every setting the API and worker read.

# Temporal (docker compose overrides TEMPORAL_ADDRESS to temporal:7233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tickets

# LLM: fake (no key, no network) | openrouter
LLM_MODE=fake
OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_MAX_TURNS=8
LLM_MAX_INVALID_ANSWERS=3

# Fake Helpdesk: probability of a temporary failure per call, in [0, 1]
HELPDESK_FAILURE_RATE=0.2

# Refund approval timeout (86400 = 24h; shorten for a demo)
APPROVAL_TIMEOUT_SECONDS=86400

LOG_LEVEL=INFO

# Tracing: empty = tracing off (docker compose defaults it to the jaeger service)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
